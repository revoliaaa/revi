Fraksi Kebutuhan Tersisa Ditutup=
	IF THEN ELSE(Indeks Intensitas Perlindungan Tanpa Karbon<1, MAX(0, Indeks Intensitas Perlindungan\
		-Indeks Intensitas Perlindungan Tanpa Karbon)/(1-Indeks Intensitas Perlindungan Tanpa Karbon\
		), 0)
	~	Dmnl
