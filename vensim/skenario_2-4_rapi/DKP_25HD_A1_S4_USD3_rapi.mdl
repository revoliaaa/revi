Indeks Capaian Pemulihan Program=
	MIN(1, Luas Penanaman Program/Target Total Penanaman RKPS)
	~	Dmnl
	~	V8 (M-4): capaian relatif program, 0 pada S0.
	|

Total Kawasan Awal=
	INITIAL(Total Kawasan)
	~	Ha
	~		|

Total Kawasan Awal Baseline=
	INITIAL(Total Kawasan Baseline)
	~	Ha
	~		|

Masyarakat Bergantung Pada Hutan=
	Masyarakat Bergantung pada Hutan Tanpa Program PS*(1-Indeks Pengurangan Ketergantungan\
		)
	~	People
	~	V8 (C-3): outcome aktual = kontrafaktual dikurangi fraksi yang beralih \
		karena program PS.
	|

Waktu Penyesuaian Persepsi Manfaat=
	2
	~	Year
	~	ASUMSI (delay penerimaan manfaat): waktu masyarakat mempersepsikan \
		perubahan manfaat PS.
	|

Manfaat Ekonomi PS per Peserta=
	IF THEN ELSE(Total Partisipasi Kegiatan PS>0, Total Manfaat Ekonomi PS/Total Partisipasi Kegiatan PS\
		, 0)
	~	Rupiah/(People*Year)
	~	V8 (M-7): manfaat dibagi peserta, bukan seluruh populasi.
	|

Respon Perilaku terhadap Manfaat PS=
	1-EXP(-Sensitivitas Pengurangan Ketergantungan terhadap Manfaat PS*Rasio Manfaat Ekonomi PS terhadap Pendapatan Dasar\
		)
	~	Dmnl
	~	V8: fungsi jenuh (diminishing returns), 0-1.
	|

Total Partisipasi Referensi=
	SAMPLE IF TRUE(Time <= Tahun Mulai Dampak Skenario Lahan, Total Partisipasi Kegiatan PS\
		, Total Partisipasi Kegiatan PS)
	~	People
	~	V8 (C-3): partisipasi status quo pada awal proyeksi; efeknya dianggap \
		sudah tercermin dalam laju BAU.
	|

Peserta Tambahan Program PS=
	MAX(0, Total Partisipasi Kegiatan PS-Total Partisipasi Referensi)
	~	People
	~	V8 (C-3): hanya peserta di atas status quo yang menghasilkan efek \
		tambahan. 0 pada S0.
	|

Proporsi Peserta Program dari Kelompok Bergantung=
	0
	~	Dmnl
	~	PERLU DATA KUESIONER: proporsi peserta tambahan yang sebelumnya bergantung \
		rentan pada hutan.
	|

Target Fraksi Ketergantungan Berkurang karena PS=
	IF THEN ELSE(Masyarakat Bergantung pada Hutan Tanpa Program PS>0, MIN(1, Peserta Tambahan Program PS\
		*Proporsi Peserta Program dari Kelompok Bergantung*Respon Perilaku terhadap Manfaat PS\
		/Masyarakat Bergantung pada Hutan Tanpa Program PS), 0)
	~	Dmnl
	~	V8 (C-3): fraksi kelompok bergantung yang beralih bila perilaku sudah \
		menyesuaikan.
	|

Waktu Transisi Mata Pencaharian=
	3
	~	Year
	~	ASUMSI (delay perubahan perilaku; perlu literatur/data).
	|

Perubahan Fraksi Ketergantungan karena PS=
	(Target Fraksi Ketergantungan Berkurang karena PS-Indeks Pengurangan Ketergantungan)\
		/Waktu Transisi Mata Pencaharian
	~	1/Year
	~	Dapat negatif (relaps) bila manfaat atau partisipasi menurun.
	|

Sensitivitas Ekspansi Lahan terhadap Pendapatan PS=
	0
	~	Dmnl
	~	PARAMETER EKSPLORATIF (M-2): efek modal/ekspansi kebun dari tambahan \
		pendapatan. 0 = tidak aktif.
	|

Indeks Ekspansi Lahan dari Pendapatan=
	IF THEN ELSE(Masyarakat Berpotensi Bergantung pada Hutan>0, MIN(1, Sensitivitas Ekspansi Lahan terhadap Pendapatan PS\
		*Rasio Manfaat Ekonomi PS terhadap Pendapatan Dasar*Peserta Tambahan Program PS/Masyarakat Berpotensi Bergantung pada Hutan\
		), 0)
	~	Dmnl
	~	V8 (M-2): jalur pendapatan yang MENINGKATKAN tekanan lahan. 0 pada S0.
	|

Faktor Ekspansi Kebun=
	1+Switch Dampak Skenario Lahan*Proporsi Deforestasi Dipengaruhi Tekanan Masyarakat*Indeks Ekspansi Lahan dari Pendapatan
	~	Dmnl
	~	Faktor pengali konversi NonHutan menjadi perkebunan pada jalur Proyek; \
		memasukkan kemungkinan rebound ekonomi.
	|

Faktor Ekspansi Kebun Baseline=
	1
	~	Dmnl
	~	V8 (M-2): pengali konversi NonHutan ke perkebunan. V8.1: = skenario; \
		Baseline = BAU kontrafaktual.
	|

Total Hutan Awal=
	INITIAL(Total Hutan)
	~	Ha
	~		|

Indeks Kondisi Hutan=
	Total Hutan/Total Hutan Awal
	~	Dmnl
	~		|

Proporsi Usaha KUPS Berbasis Hutan=
	0
	~	Dmnl
	~	PERLU DATA (M-3): proporsi manfaat KUPS yang bergantung pada sumber daya \
		hutan (HHBK, ekowisata, mangrove).
	|

Faktor Kondisi Hutan untuk Usaha KUPS=
	1-Proporsi Usaha KUPS Berbasis Hutan+Proporsi Usaha KUPS Berbasis Hutan*Indeks Kondisi Hutan
	~	Dmnl
	~	V8 (M-3): umpan balik kondisi hutan ke kesejahteraan.
	|

HOK Penanaman per Pekerja per Tahun=
	60
	~	HOK/(People*Year)
	~	ASUMSI (perlu data): untuk mengonversi HOK menjadi jumlah pekerja.
