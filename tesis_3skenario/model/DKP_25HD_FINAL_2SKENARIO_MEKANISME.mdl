Pendapatan KUPS Total=
	IF THEN ELSE(Switch Ekonomi KUPS Empiris=1, MAX(0, Manfaat Ekonomi KUPS)*Porsi Surplus KUPS Dibagikan ke Anggota , Manfaat Ekonomi KUPS)
	~	Rupiah/Year
