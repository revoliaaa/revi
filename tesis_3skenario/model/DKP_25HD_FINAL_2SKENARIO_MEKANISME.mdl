RT Bergantung dengan Efek Program Positif=
	IF THEN ELSE(Efek Program per RT Kelompok TP>0, Jumlah RT Kelompok TP, 0)+IF THEN ELSE (Efek Program per RT Kelompok TN>0, Jumlah RT Kelompok TN, 0)+IF THEN ELSE(Efek Program per RT Kelompok DP >0, Jumlah RT Kelompok DP, 0)+IF THEN ELSE(Efek Program per RT Kelompok DN>0, Jumlah RT Kelompok DN , 0)
	~	Household
	~	REV-V5.1 2026-10-30 (VARIABEL BARU): RT bergantung yang pendapatan bersihnya naik karena program. Sumber: Turunan model. Kualitas -.
	|

RT Bergantung dengan Efek Program Negatif=
	IF THEN ELSE(Efek Program per RT Kelompok TP<0, Jumlah RT Kelompok TP, 0)+IF THEN ELSE (Efek Program per RT Kelompok TN<0, Jumlah RT Kelompok TN, 0)+IF THEN ELSE(Efek Program per RT Kelompok DP <0, Jumlah RT Kelompok DP, 0)+IF THEN ELSE(Efek Program per RT Kelompok DN<0, Jumlah RT Kelompok DN , 0)
	~	Household
	~	REV-V5.1 2026-10-30 (VARIABEL BARU): RT bergantung yang pendapatan bersihnya turun karena program. Sumber: Turunan model. Kualitas -.
